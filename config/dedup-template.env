# Air Gap Deduplication Instance Configuration Template
# Copy this file to /etc/default/airgap-dedup-<instance-name>
# and customize for your instance

# Core Topics
RAW_TOPICS=transfer
CLEAN_TOPIC=dedup
GAP_TOPIC=gaps
# Pre-create GAP_TOPIC with cleanup.policy=compact (not delete/compact,delete).
# See doc/Deduplication.md for retention, sizing and changelog requirements.

# Kafka Connection
BOOTSTRAP_SERVERS=localhost:9092

# State Management
STATE_DIR_CONFIG=/var/lib/airgap/dedup/state-INSTANCE/
WINDOW_SIZE=1000
MAX_WINDOWS=10

# Timing Configuration
GAP_EMIT_INTERVAL_SEC=60
COMMIT_INTERVAL_MS=5000
# PERSIST_INTERVAL_MS is deprecated: state updates per record, not on a timer.

# Application Configuration
APPLICATION_ID=dedup-gap-app-INSTANCE
# Number of warm standby replicas per partition for faster failover.
# Requires (NUM_STANDBY_REPLICAS + 1) * <partition_count> running instances.
# Set to 0 to disable standbys (fewer instances needed, slower failover).
NUM_STANDBY_REPLICAS=1

# Java Configuration (can be overridden)
JAVA_OPTS="-Xms512m -Xmx4g"

# Logging
logLevel=INFO
