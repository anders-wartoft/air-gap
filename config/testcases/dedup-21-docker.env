# Dedup env for TC-21 chain run (two upstream clusters sharing a topic
# name, both forwarded by upstream-a/upstream-b into one downstream).
#
# The committed dedup-21.env is a bare-metal mTLS config
# (KAFKA_SECURITY_PROTOCOL=SSL, /mnt/hgfs/... keystore paths) — none of
# that applies here; BOOTSTRAP_SERVERS is also overridden unconditionally
# by docker-compose.yml's `dedup` service `environment:` block (DEDUP_BOOTSTRAP),
# so the plaintext value below is cosmetic.
#
# RAW_TOPICS=transfer only: both clusters' events arrive at the SAME
# downstream Kafka topic "transfer" (air-gap's downstream doesn't know or
# care which upstream cluster an event originated from — that's the whole
# point of TC-21). The non-overlapping partitionStartValue=0/10 ranges on
# the two upstreams keep their dedup/gap-detector IDs from colliding.
#
# GAP_EMIT_INTERVAL_SEC=5 (vs. the committed 60) so gaps opened by phase
# 1's deliverFilter are visible in the gaps topic within the chain's short
# runtime.

WINDOW_SIZE=1000
MAX_WINDOWS=10
RAW_TOPICS=transfer
CLEAN_TOPIC=dedup
GAP_TOPIC=gaps
STATE_DIR_CONFIG=/tmp/dedup_state_21/
GAP_EMIT_INTERVAL_SEC=5
MISSING_REPORT_INTERVAL_SEC=5
PERSIST_INTERVAL_MS=10000
