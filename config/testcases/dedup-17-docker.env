# Dedup env for TC-17 chain run — dedup connects to Kafka over TLS.
#
# The Docker kafka-downstream brokers' SSL listeners (9094/8094) run
# with KAFKA_SSL_CLIENT_AUTH=none (server-side TLS only, see
# docker-compose.yml) — so dedup needs ONLY a truststore to verify the
# broker's certificate, no client keystore/mTLS.
#
# kafka-trust.jks is the SAME PKCS12 truststore the Docker Kafka
# brokers themselves use to trust each other (mounted read-only from
# certs/kafka/ssl/ at /airgap/certs/kafka/ssl/ — see docker-compose.yml's
# volume list on the dedup service). Password is the well-known
# "changeit" used throughout this test env's generated certs (see
# certs/kafka/ssl/kafka-truststore-creds).
#
# IMPORTANT: BOOTSTRAP_SERVERS here is a fallback only — the dedup
# compose service's `environment:` block sets BOOTSTRAP_SERVERS from
# ${DEDUP_BOOTSTRAP:-kafka-downstream:9092,...}, which ALWAYS wins over
# this env_file (same key, environment: overrides env_file in Compose).
# testcases/17.env must set DEDUP_BOOTSTRAP to the SSL ports, or dedup
# will silently connect PLAINTEXT instead of TLS.

WINDOW_SIZE=1000
MAX_WINDOWS=10
RAW_TOPICS=transfer
CLEAN_TOPIC=dedup
GAP_TOPIC=gaps
BOOTSTRAP_SERVERS=kafka-downstream.sitia.nu:9094,kafka-downstream.sitia.nu:8094
STATE_DIR_CONFIG=/tmp/dedup_state_17/
GAP_EMIT_INTERVAL_SEC=5
MISSING_REPORT_INTERVAL_SEC=5
PERSIST_INTERVAL_MS=10000

KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_TRUSTSTORE_LOCATION=/airgap/certs/kafka/ssl/kafka-trust.jks
KAFKA_SSL_TRUSTSTORE_PASSWORD=changeit
KAFKA_SSL_TRUSTSTORE_TYPE=PKCS12
