# Dedup env for TC-23 chain run (inputFilterRules + resend respects
# filters). Same shape as dedup-14-docker.env — see that file for the
# BOOTSTRAP_SERVERS override and short-interval rationale; STATE_DIR_CONFIG
# distinct here so a stale TC-14 state dir can't leak into this test.

WINDOW_SIZE=1000
MAX_WINDOWS=10
RAW_TOPICS=transfer
CLEAN_TOPIC=dedup
GAP_TOPIC=gaps
STATE_DIR_CONFIG=/tmp/dedup_state_23/
GAP_EMIT_INTERVAL_SEC=5
MISSING_REPORT_INTERVAL_SEC=5
PERSIST_INTERVAL_MS=10000
