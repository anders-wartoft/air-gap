# Dedup env for TC-13 chain run.
#
# TC-13 proves REQ-27/28 — periodic received/sent/missing counters.
# Two separate dedup env vars control two separate periodic emits:
#
#   * GAP_EMIT_INTERVAL_SEC — how often the dedup *flushes gaps into
#     the GAP_TOPIC*. Not what REQ-27/28 is about.
#   * MISSING_REPORT_INTERVAL_SEC — how often the dedup *prints the
#     [MISSING-REPORT] JSON summary line* to its log. THIS is the one
#     REQ-27/28 target. Default is 60; the chain only runs ~30 s so we
#     drop it to 5 so verify-tc13.sh observes multiple cycles.

WINDOW_SIZE=1000
MAX_WINDOWS=10
RAW_TOPICS=transfer
CLEAN_TOPIC=dedup
GAP_TOPIC=gaps
STATE_DIR_CONFIG=/tmp/dedup_state_13/
GAP_EMIT_INTERVAL_SEC=5
MISSING_REPORT_INTERVAL_SEC=5
PERSIST_INTERVAL_MS=10000
