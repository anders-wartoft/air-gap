# Dedup config for TC-12 chain run.
#
# Both upstream chains funnel UDP into the single downstream container,
# which translates every event to kafka-downstream[transfer-12a]. So
# RAW_TOPICS has just that one entry (the bare-metal procedure uses
# RAW_TOPICS=transfer-12a,transfer-12b because it runs two downstreams).
# Dedup collapses the ~100 duplicates generated by both chains
# delivering the same ~100 events, emitting 100 unique records to the
# clean "dedup" topic that lg-sink reads.

WINDOW_SIZE=1000
MAX_WINDOWS=10
RAW_TOPICS=transfer-12a
CLEAN_TOPIC=dedup
GAP_TOPIC=gaps
BOOTSTRAP_SERVERS=kafka-downstream:9092,kafka-downstream-2:8092
STATE_DIR_CONFIG=/tmp/dedup_state_12/
GAP_EMIT_INTERVAL_SEC=60
PERSIST_INTERVAL_MS=10000
