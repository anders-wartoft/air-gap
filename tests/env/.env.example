# Copy to `.env` and edit for your run.
#
# All variables are optional; defaults in docker-compose.yml match a single-
# machine layout with one two-broker upstream cluster, one two-broker
# downstream cluster, and a topic-init that creates the standard topic set.
#
# run-testcase.sh sources tests/env/testcases/NN.env on top of this file, so
# values here are the baseline and per-testcase settings win.

# ---------- Orthogonal infrastructure versions ----------
# Base OS image for the air-gap containers. Bump to update OS independently.
UPSTREAM_BASE_IMAGE=rockylinux:9
DOWNSTREAM_BASE_IMAGE=rockylinux:9

# Kafka broker image (bump to update Kafka independently of OS/air-gap).
KAFKA_IMAGE=confluentinc/confluent-local:7.6.1

# JVM image for the deduplicator (bump to update the JVM independently).
DEDUP_IMAGE=eclipse-temurin:17-jre-noble

# ---------- Air-gap binary / jar location on the host ----------
# Go binaries. Switch to ../../target/linux-arm64 on Apple Silicon / arm64 Linux.
AIRGAP_BIN_DIR=../../target/linux-amd64

# ---------- Which testcase to run (overridden by testcases/NN.env) ----------
UPSTREAM_A_CONFIG=/airgap/config/upstream-docker.properties
UPSTREAM_B_CONFIG=/airgap/config/upstream-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/downstream-docker.properties
DEDUP_ENV_FILE=../../config/testcases/dedup-9.env
CREATE_CONFIG=/airgap/config/create.properties
RESEND_CONFIG=/airgap/config/resend.properties

# ---------- Network overrides for the testcase properties ----------
# Testcase .properties files reference bare-metal hostnames
# (kafka-upstream.sitia.nu, kafka-downstream.sitia.nu, nic=enp2s0, ...).
# These env vars override those values so the testcase files stay untouched.
UPSTREAM_A_NIC=eth0
UPSTREAM_A_TARGET_IP=downstream
UPSTREAM_A_BOOTSTRAP=kafka-upstream:9092,kafka-upstream-2:8092

UPSTREAM_B_NIC=eth0
UPSTREAM_B_TARGET_IP=downstream
UPSTREAM_B_BOOTSTRAP=kafka-upstream:9092,kafka-upstream-2:8092

DOWNSTREAM_NIC=eth0
DOWNSTREAM_BOOTSTRAP=kafka-downstream:9092,kafka-downstream-2:8092

DEDUP_BOOTSTRAP=kafka-downstream:9092,kafka-downstream-2:8092

CREATE_BOOTSTRAP=kafka-downstream:9092,kafka-downstream-2:8092

RESEND_NIC=eth0
RESEND_TARGET_IP=downstream
RESEND_BOOTSTRAP=kafka-upstream:9092,kafka-upstream-2:8092

# ---------- Topic bootstrap ----------
# 12 hours in milliseconds, matches the original bare-metal topic script.
TOPIC_INIT_RETENTION_MS=43200000
# Override only if your Kafka service names differ.
TOPIC_INIT_UPSTREAM_BOOTSTRAP=kafka-upstream:9092,kafka-upstream-2:8092
TOPIC_INIT_DOWNSTREAM_BOOTSTRAP=kafka-downstream:9092,kafka-downstream-2:8092
TOPIC_INIT_UPSTREAM_B_BOOTSTRAP=kafka-upstream-b:9092,kafka-upstream-b-2:8092
