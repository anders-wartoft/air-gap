# Testcase 7 — Large log entries (fragmentation/defragmentation)
# Covers: REQ-19

TC_TITLE="Large binary log entries fragment and reassemble byte-exactly"
TC_COVERS="19"
TC_PROFILES=""

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-7.properties
# Docker-friendly downstream (binds UDP to 0.0.0.0 so the upstream-a
# container can reach it across the Docker bridge).
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-7-docker.properties

# TC-7 replaces the LG producer+sink with a single Go-based tester
# (tc7-binary-test, see docker-compose.yml). It:
#   1. compiles Upload.go and Download.go (both shipped under
#      tests/env/bin/ — same tools the manual TC-7 procedure uses)
#   2. generates a FILE_BYTES file of /dev/urandom bytes
#   3. uploads it NUM_MESSAGES times to kafka-upstream[transfer]
#   4. lets the air-gap chain carry each copy over UDP (payloadSize=1400
#      in upstream-airgap-7.properties => each ~200KB file fragments into
#      ~150 UDP packets; 10 copies ≈ 1500 fragments total)
#   5. downloads from kafka-downstream[transfer] and md5sum compares
#      each downloaded file against the uploaded original.
#
# This mirrors the manual TC-7 bare-metal procedure in TESTCASES.md
# ("Upload /bin/ls → air-gap → Download, then md5sum") byte-exactly.
AUTO_EXIT_PROFILE=tc7-binary-test
AUTO_EXIT_SERVICE=tc7-binary-test

TC7_EXPECTED_COUNT=10
TC7_FILE_BYTES=204800
TC7_TIMEOUT_SECONDS=120

EXPECTED_DUPLICATES=0
TC_DRAIN_SECONDS=5
