# Testcase 24 — TLS 1.3 / mTLS over TCP (SIGHUP cert rotation)
# Covers: REQ-41, REQ-42, REQ-43, REQ-44, REQ-47
#
# Part A (cleartext baseline) is skipped as redundant — already fully
# covered by TC-1/3/22. This chain automates Parts B, C, D of the manual
# procedure in full (see tc24-tls-test.sh for the detailed phase
# breakdown): mTLS handshake + cleartext-rejection + two concurrent mTLS
# clients (Part B), one-way/server-only auth (Part C), and live SIGHUP
# cert rotation proven loss-free (Part D).
#
# No Kafka, no LogGenerator anywhere in this testcase's data path
# (source=random upstream, target=cmd downstream, same shape as TC-22) —
# tc24-settle-timer just bounds the initial handshake settle time; ALL the
# real testing happens in POST_DRAIN_SCRIPT=tc24-tls-test.sh.

TC_TITLE="TLS 1.3 / mTLS over TCP, with SIGHUP cert rotation"
TC_COVERS="41, 42, 43, 44, 47"
TC_PROFILES=""

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-tls-24a-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-tls-24-docker.properties

# Seeds /airgap/tmp/tc24-rotate.{crt,key,key.pw} (writable cert copies
# upstream-a reads from) BEFORE the stack boots — must exist at
# upstream-a's very first start. See tc24-pre-up.sh.
PRE_UP_SCRIPT=tc24-pre-up.sh

AUTO_EXIT_PROFILE=tc24-settle-timer
AUTO_EXIT_SERVICE=tc24-settle-timer
TC24_SETTLE_SECONDS=8

# All real testing (Parts B/C/D) happens here — see tc24-tls-test.sh for
# the full phase breakdown. report_check lines throughout ARE the
# pass/fail for this testcase; the generic sent/received/duplicate
# verdict is a trivial marker-line pass (no Kafka/LG in this test's data
# path, same as TC-22), not authoritative.
POST_DRAIN_SCRIPT=tc24-tls-test.sh

EXPECTED_DUPLICATES=0
EXPECTED_MISSING=0
