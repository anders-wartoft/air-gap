# Testcase 21 — Two clusters, same topic name, into one dedup
# Covers: REQ-36
#
# Scope note: the manual procedure has 3 phases (1: both clusters run with
# a gap-creating deliverFilter, feeding one dedup — proves cross-cluster
# dedup; 2: upstreams restart without the filter + fresh groupID, full
# replay closes the gaps — proves no data loss; 3: a create+cluster-scoped
# resend cycle closes any gaps still outstanding after replay). This chain
# automates phases 1+2 — TC-21's unique claim (two clusters sharing a
# topic name into one dedup, no data loss). Phase 3's create/resend
# mechanism is already rigorously chain-tested standalone by TC-14/TC-18;
# re-run it manually via ./run-testcase.sh 21 -pause if you need to verify
# the cluster-scoped resend step itself.

TC_TITLE="Two clusters, same topic, into a single dedup"
TC_COVERS="36"
TC_PROFILES="dual second-cluster dedup"

# Phase 1: both upstreams run with deliverFilter=2,4,6 (deliver only those
# offsets), deliberately opening gaps in partitions 0-4 (cluster A) and
# 10-14 (cluster B).
UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-21a-docker.properties
UPSTREAM_B_CONFIG=/airgap/config/testcases/upstream-airgap-21b-docker.properties
UPSTREAM_B_BOOTSTRAP=kafka-upstream-b:9092,kafka-upstream-b-2:8092

DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-21-docker.properties
DEDUP_ENV_FILE=../../config/testcases/dedup-21-docker.env

# Two independent LogGenerator producers, one per cluster (see
# lg-producer-b in docker-compose.yml). LG_PRODUCER_CONFIG (cluster A) is
# the compose --exit-code-from source; the runner separately waits for
# lg-producer-b (cluster B) to also finish before proceeding, so neither
# cluster's phase-1 stream is cut short by the other finishing first.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-21a-docker.properties
LG_PRODUCER_B_CONFIG=/airgap/config/testcases/upstream-lg-21b-docker.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-21-docker.properties

# Grace period for dedup's Kafka Streams app to finish REBALANCING before
# the first event — same race as every other dedup testcase.
LG_STARTUP_DELAY=15

# Phase 2: restart BOTH upstreams with no-filter configs + fresh groupIDs
# so Kafka replays each cluster's topic from the start, closing the gaps
# phase 1 opened. PHASE2_RERUN_LG_PRODUCER=1 additionally re-runs both LG
# producers with their ORIGINAL (phase-1) configs, matching the documented
# manual procedure's "generate another 10 logs per cluster" step — this
# produces the SAME Cluster1_1..10 / Cluster2_1..10 range a second time,
# which is what creates the documented "each value delivered twice"
# duplicates once combined with the fresh-groupID full replay.
UPSTREAM_A_PHASE2_CONFIG=/airgap/config/testcases/upstream-airgap-21a2-docker.properties
UPSTREAM_B_PHASE2_CONFIG=/airgap/config/testcases/upstream-airgap-21b2-docker.properties
PHASE2_RERUN_LG_PRODUCER=1
PHASE2_SETTLE_SECONDS=5
PHASE2_DRAIN_SECONDS=45

# The generic sent/received/duplicate verdict (run-testcase.sh) only reads
# cluster A's lg-producer log, so with a phase-2 re-run its "sent" reading
# reflects just that LAST run (10), not the full 4-wave total across both
# clusters/phases — it's informational here, not authoritative. The real
# pass/fail for this testcase is verify-tc21.sh, which checks dedup's own
# counters directly for both clusters' partition ranges.
EXPECTED_DUPLICATES=10
EXPECTED_MISSING=0-5
VERIFY_SCRIPT=verify-tc21.sh
