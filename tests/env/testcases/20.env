# Testcase 20 — TCP transport, late-starting downstream recovers cleanly
# Covers: REQ-35

TC_TITLE="TCP transport upstream->downstream (late-starting downstream recovers)"
TC_COVERS="35"
TC_PROFILES=""

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-20-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-20-docker.properties

# LogGenerator producer+sink so the runner auto-exits on lg-producer.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-20.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-20-docker.properties

# The core of TC-20: hold the real `downstream` container's binary launch
# back so upstream-a's TCP connection is genuinely unavailable for the
# first few seconds of the run (see STARTUP_DELAY in entrypoint.sh,
# wired from this var in docker-compose.yml). upstream-a's default TCP
# retry settings (tcpRetryInterval=1000ms, tcpRetryTimes=0/infinite) mean
# it just keeps retrying the same not-yet-acknowledged message forever —
# nothing is dropped, Kafka's offset for that message simply isn't
# committed until the retry succeeds. 10s is enough to produce several
# retry log lines without materially slowing the chain down.
DOWNSTREAM_STARTUP_DELAY=10

# Plain end-to-end: each event appears exactly once at the sink, despite
# the late downstream start.
EXPECTED_DUPLICATES=0

# Producer runs ~20s (eps=50, limit=1000), overlapping with downstream's
# 10s hold-back. Once downstream comes up it has to work through whatever
# backlog built up in Kafka plus keep up with the producer's remaining
# output, so give it a generous drain window afterward.
TC_DRAIN_SECONDS=25

# Qualitative check: prove the TCP-unavailable retry + recovery path was
# actually exercised (not just that the bulk count happened to pass).
VERIFY_SCRIPT=verify-tc20.sh
