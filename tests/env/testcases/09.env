# Testcase 9 — Deduplication
# Covers: REQ-4

TC_TITLE="Deduplication: duplicates in Kafka are removed by dedup"
TC_COVERS="4"
TC_PROFILES="dedup"

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-9.properties
# Phase 2: after the LogGenerator producer finishes, the runner stops
# upstream-a and recreates it with this no-filter config + fresh groupID so
# Kafka replays every event. The dedup app filters the ~80 that already
# reached the clean topic, and the previously dropped multiples of 5 are
# delivered — closing the gaps that upstream-airgap-9.properties opened on
# purpose (deliverFilter=1,2,3,4,6,7,8,9,11,12,13,14). This mirrors the
# manual TC-9 procedure in tests/documents/TESTCASES.md.
UPSTREAM_A_PHASE2_CONFIG=/airgap/config/testcases/upstream-airgap-9b.properties
# Give the gap-fill phase extra time to flow through the pipeline.
PHASE2_DRAIN_SECONDS=45

DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-9.properties
DEDUP_ENV_FILE=../../config/testcases/dedup-9.env

# LogGenerator producer+sink. Setting LG_PRODUCER_CONFIG auto-activates the
# lg-producer profile and makes the runner pass --exit-code-from lg-producer,
# so the entire stack tears down as soon as LogGenerator has sent its `limit`
# events.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-9.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-9.properties

# Grace period at LG producer startup — wait for dedup's Kafka Streams
# tasks to finish REBALANCING → RUNNING before writing the first event.
# TC-9 happens to usually clear this race by chance (dedup starts
# faster for the smaller workload) but the same race pattern applies
# as TC-10, so the delay is set defensively to prevent a flake if the
# host is loaded. See tests/env/lg-entrypoint.sh for the actual sleep.
LG_STARTUP_DELAY=15

