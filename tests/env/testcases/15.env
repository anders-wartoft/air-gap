# Testcase 15 — Payload compression (compressWhenLengthExceeds)
# Covers: REQ-30
#
# Unlike the dedup-focused testcases, TC-15 is about the WIRE FORMAT: does
# compression actually happen above the configured threshold, is it
# skipped below it, and does it still work when the channel is ALSO
# encrypted? The chain variant proves this with a real tcpdump capture
# on the downstream container (see tc15-compression-test.sh), not just
# end-to-end counters.
#
# LG_PRODUCER_CONFIG here is only a quick auto-exit ANCHOR (short-message
# burst) so run-testcase.sh has something to wait on — it is NOT what's
# captured/asserted. The actual 3-phase test (short/no-enc,
# long/no-enc, long/encrypted) runs entirely inside the POST_DRAIN_SCRIPT
# hook, which starts/stops its own tcpdump captures and lg-producer runs
# per phase.

TC_TITLE="Payload compression above configurable size"
TC_COVERS="30"
TC_PROFILES=""

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-15-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-15-docker.properties

# Anchor burst — short messages, finishes in under a second. The REAL
# short-message capture happens again (deliberately) inside
# tc15-compression-test.sh's Phase A, with tcpdump already attached.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-15.properties

# No dedup, no REBALANCING race here — keep the drain short.
TC_DRAIN_SECONDS=2

POST_DRAIN_SCRIPT=tc15-compression-test.sh
TC15_SHORT_LG_CONFIG=/airgap/config/testcases/upstream-lg-15.properties
TC15_LONG_LG_CONFIG=/airgap/config/testcases/upstream-lg-15b.properties
TC15_ENCRYPTED_UPSTREAM_CONFIG=/airgap/config/testcases/upstream-airgap-15b-docker.properties
TC15_CAPTURE_SECONDS=3
TC15_ENCRYPTION_SETTLE_SECONDS=8

# The anchor burst's own short messages already land in
# kafka-downstream[transfer] before the hook even starts, and the sink
# role here is a plain `kafka-console-consumer`, not LogGenerator — so
# the runner's usual "sent/received" counter verdict doesn't apply.
# EXPECTED_MISSING/EXPECTED_DUPLICATES are irrelevant; pass/fail comes
# entirely from the POST_DRAIN_SCRIPT exit code.
