# Testcase 12 — Load sharing (two upstreams share one cluster's partitions)
# Covers: REQ-24
#
# Two upstream air-gap processes read from the same two-broker upstream
# cluster. A single dedup merges them.
#
# CHAIN NOTE (bare-metal and chain diverge):
#   * The bare-metal procedure uses `deliverFilter=1,3,5` on 12a and
#     `=2,4,6` on 12b to split the load (odd vs even Kafka offsets).
#   * The chain variant uses the same filter split via the `-docker`
#     variants. This works for 100% delivery only because of the
#     posMod fix in src/filter/filter.go — pre-fix, Go's signed
#     modulo made offset 0 land on NEITHER chain (5 events per 100
#     silently dropped). Post-fix, offset 0 goes to the even chain
#     (2,4,6) and nothing is lost.
#   * Both upstreams target port 1234 (the committed 12b config aims
#     at 1235 for a second downstream instance — the Docker rig has
#     only one). The downstream translates "transfer" → "transfer-12a"
#     and dedup reads that single topic.

TC_TITLE="Load sharing: two upstreams split partitions"
TC_COVERS="24"
TC_PROFILES="dual dedup"

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-12a-docker.properties
UPSTREAM_B_CONFIG=/airgap/config/testcases/upstream-airgap-12b-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-12-docker.properties
DEDUP_ENV_FILE=../../config/testcases/dedup-12-docker.env

# LogGenerator producer+sink.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-12-docker.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-12.properties

# Each chain forwards a disjoint ~half of the 100 events (odd offsets
# via chain-a's deliverFilter=1,3,5; even offsets including 0 via
# chain-b's deliverFilter=2,4,6). The two halves don't overlap, so
# ~100 records land on transfer-12a and dedup sees ZERO duplicates.
EXPECTED_DUPLICATES=0

# Dedup Kafka Streams needs 10–15 s to finish REBALANCING before the
# first event lands — same race pattern as TC-9/TC-10. See
# tests/env/lg-entrypoint.sh for the actual sleep.
LG_STARTUP_DELAY=15

# Prove the load really was split 50/50 (not "one chain delivered
# everything and the other was silently dead"). verify-tc12.sh checks:
#   1. per-chain `total_sent` from each upstream's STATISTICS JSON log
#      line (requires logStatistics=5 in the -docker upstream configs
#      so the Go app emits per-chain forwarded counts at INFO).
#      Each chain must be inside [0.4, 0.6] × LG_LIMIT.
#   2. kafka-downstream[transfer-12a] record count ≈ LG_LIMIT (NOT
#      2× — the chains' outputs are disjoint).
# Without this, a silently-dead upstream-b with upstream-a sending
# the full 100 would still appear to PASS at the counter-verdict
# level (dedup would just see no duplicates to collapse).
VERIFY_SCRIPT=verify-tc12.sh
TC12_LG_LIMIT=100
TC12_DOWNSTREAM_TOPIC=transfer-12a
