# Testcase 10 — systemd service lifecycle
# Covers: REQ-8, REQ-17
#
# TC-10 is really about running air-gap under systemd on the host OS.
# The systemd aspects (unit files, memory bounds, service dependencies)
# are inherently manual and are left to the bare-metal procedure in
# TESTCASES.md.
#
# The chain-run variant below reuses the TC-9 two-phase deliverFilter →
# gap-fill pattern but on the transfer2 / dedup2 / gaps2 topic family
# that this test case uses. That exercises the config files, the
# air-gap pipeline, and the dedup app end-to-end, which is the non-
# systemd portion of what TC-10 proves.

TC_TITLE="Services under systemd — chain exercises the config/dedup path"
TC_COVERS="8, 17"
TC_PROFILES="dedup"

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-10-docker.properties
# Phase 2: fresh groupID + no deliverFilter so Sarama replays every
# event the phase-1 filter dropped (multiples of 5), filling the gaps.
UPSTREAM_A_PHASE2_CONFIG=/airgap/config/testcases/upstream-airgap-10b-docker.properties
PHASE2_DRAIN_SECONDS=45

DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-10-docker.properties
DEDUP_ENV_FILE=../../config/testcases/dedup-10.env

# LogGenerator producer+sink.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-10-docker.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-10.properties

# Phase 1 drops ~20 of 100; phase 2 fills them. Dedup absorbs the ~80
# duplicates from phase 2's replay, so the sink sees 100 unique with
# 0 duplicates.
EXPECTED_DUPLICATES=0

# Grace period at LG producer startup: block for this many seconds
# before writing the first event to kafka-upstream[transfer2]. Without
# this, LG can finish all 100 writes in ~1 s — in the same second
# dedup transitions REBALANCING → RUNNING — and the first few events
# race dedup's EOS-v2 state-store initialisation. Observed symptom:
# occasional 1-event loss with a different missing counter each run.
# 15 s comfortably clears the Streams task-restoration window for a
# fresh group across all 15 downstream partitions. Interpreted by
# tests/env/lg-entrypoint.sh.
LG_STARTUP_DELAY=15

# Give dedup extra breathing room between phase 1 (fresh group reads
# everything from offset 0 of transfer2) and phase 2 (fresh group id
# replays all events through the air-gap chain). Default 5 s is enough
# for TC-9's 100-event burst; 10 s is kinder when the Streams app
# re-reads changelog offsets per partition.
PHASE2_SETTLE_SECONDS=10
