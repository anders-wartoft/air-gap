# TC-29 — Version 1 signed log checkpoint verification.
TC_TITLE="Signature verification and tamper detection"
TC_COVERS="52.10"
TC_PROFILES=""

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-3.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-3.properties

UPSTREAM_LOG_FORMAT=otel
UPSTREAM_LOG_HASH=SHA256
UPSTREAM_LOG_HASH_CHAIN=10
UPSTREAM_LOG_SIGNING_CERT=/airgap/certs/tmp/tc29/signer.crt
UPSTREAM_LOG_SIGNING_KEY=/airgap/certs/tmp/tc29/signer.key
UPSTREAM_LOG_SIGNER_ID=urn:airgap:test:tc29
UPSTREAM_LOG_SIGNING_EKU=1.3.6.1.4.1.55555.29.1

DOWNSTREAM_LOG_FORMAT=otel
DOWNSTREAM_LOG_HASH=SHA256
DOWNSTREAM_LOG_HASH_CHAIN=10
DOWNSTREAM_LOG_SIGNING_CERT=/airgap/certs/tmp/tc29/signer.crt
DOWNSTREAM_LOG_SIGNING_KEY=/airgap/certs/tmp/tc29/signer.key
DOWNSTREAM_LOG_SIGNER_ID=urn:airgap:test:tc29
DOWNSTREAM_LOG_SIGNING_EKU=1.3.6.1.4.1.55555.29.1

LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-14-docker.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-3-docker.properties
LG_STARTUP_DELAY=15
TC_DRAIN_SECONDS=15

PRE_UP_SCRIPT=tc29-generate-certificate.sh
VERIFY_SCRIPT=verify-tc29.sh

EXPECTED_DUPLICATES=0
EXPECTED_MISSING=0
