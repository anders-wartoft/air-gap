# Testcase 5 — Configuration via environment variables
# Covers: REQ-22
#
# BARE-METAL / MANUAL: the detailed procedure in TESTCASES.md walks the
# user through every AIRGAP_UPSTREAM_* / AIRGAP_DOWNSTREAM_* field one at
# a time, observing a `[FATAL] Missing required configuration: ...` for
# each until the config is complete. That walkthrough is inherently
# interactive and stays manual-only.
#
# CHAIN VERSION (this file): a smoke-level verification that the env-var
# override pathway is live end-to-end. We reuse the TC-3 plain-text
# configs (which already have "wrong-for-Docker" nic/targetIP/bootstrap
# values written in the properties file) and let docker-compose.yml's
# AIRGAP_UPSTREAM_* / AIRGAP_DOWNSTREAM_* env vars take over. On startup
# both airgap binaries emit lines like
#   [INFO] Overriding nic with environment variable: AIRGAP_UPSTREAM_NIC with value: eth0
# — if those overrides weren't effective the pipeline would never run at
# all (the file-level targetIP=127.0.0.1 would prevent UDP crossing the
# Docker bridge, the file-level bootstrapServers would resolve wrong,
# etc.). A successful 1000/1000 verdict therefore proves REQ-22 to the
# chain's satisfaction.

TC_TITLE="Configuration via environment variables (smoke)"
TC_COVERS="22"
TC_PROFILES=""

# Reuse TC-3's plain-text configs. These contain file-level values that
# would NOT work in the Docker env; the pipeline only functions because
# compose's env-var pass-through overrides them.
UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-3.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-3.properties

# Explicit env-var overrides so the manifest documents what the chain is
# actually testing. The values intentionally differ from the properties
# file values so the "Overriding X with environment variable: Y" log
# lines appear on upstream/downstream startup. These shadow the
# docker-compose.yml defaults (which happen to resolve to the same
# values); keeping them here makes the override pathway explicit.
UPSTREAM_A_NIC=eth0
UPSTREAM_A_TARGET_IP=downstream
UPSTREAM_A_BOOTSTRAP=kafka-upstream:9092,kafka-upstream-2:8092
DOWNSTREAM_NIC=eth0
DOWNSTREAM_BOOTSTRAP=kafka-downstream:9092,kafka-downstream-2:8092

# LogGenerator producer+sink so the runner auto-exits on lg-producer.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-3.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-3-docker.properties

EXPECTED_DUPLICATES=0
TC_DRAIN_SECONDS=15

# Root cause of an intermittent single dropped event near the start of the
# run (same class of issue found and fixed for TC-1/TC-2): upstream-a's
# Kafka consumer group and downstream's UDP listener socket are only
# "started" (per compose depends_on), not yet fully warmed up (group
# joined / socket bound) when lg-producer's first events would otherwise
# go out. A grace period — not a tolerance band — gives both sides time
# to settle before the first byte is sent.
LG_STARTUP_DELAY=15
