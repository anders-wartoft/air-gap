# TC-28 — optional OTLP/JSON application logs plus create/resend red thread.
TC_TITLE="OTLP logs: filtered transfer and resend recovery"
TC_COVERS="52"
TC_PROFILES="dedup"

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-28-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-14-docker.properties
DEDUP_ENV_FILE=../../config/testcases/dedup-28-docker.env
CREATE_CONFIG=/airgap/config/testcases/create-14.properties
RESEND_CONFIG=/airgap/config/testcases/resend-14.properties

UPSTREAM_LOG_FORMAT=otel
DOWNSTREAM_LOG_FORMAT=otel
CREATE_LOG_FORMAT=otel
RESEND_LOG_FORMAT=otel
DEDUP_LOG_CONFIG=/airgap/config/log4j2-otel.xml

LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-14-docker.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-14.properties
LG_STARTUP_DELAY=15
TC_DRAIN_SECONDS=15

POST_DRAIN_SCRIPT=tc28-resend.sh
TC28_PROPAGATION_WAIT=20
TC28_RESEND_EPS=50

EXPECTED_DUPLICATES=0
EXPECTED_MISSING=0
VERIFY_SCRIPT=verify-tc28.sh
TC28_PARTITION_COUNT=15
