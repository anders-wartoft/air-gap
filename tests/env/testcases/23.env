# Testcase 23 — inputFilterRules + resend respects filters
# Covers: REQ-38, REQ-39
#
# Same create/resend gap-closing mechanism as TC-14, PLUS an independent
# content filter (inputFilterRules=deny:10) active on BOTH upstream and
# resend. The committed bare-metal upstream-airgap-23.properties /
# resend-23.properties had these rules present but commented out — dead
# config that never actually exercised what this testcase claims to test.
# Enabled here. See upstream-airgap-23-docker.properties /
# resend-23-docker.properties for the exact mechanics.

TC_TITLE="inputFilterRules: filtered events do not create gaps; resend obeys filter"
TC_COVERS="38, 39"
TC_PROFILES="dedup"

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-23-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-23-docker.properties
DEDUP_ENV_FILE=../../config/testcases/dedup-23-docker.env
CREATE_CONFIG=/airgap/config/testcases/create-23-docker.properties
RESEND_CONFIG=/airgap/config/testcases/resend-23-docker.properties

# LogGenerator producer+sink.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-23-docker.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-23-docker.properties

# Dedup Kafka Streams needs 10-15s to finish REBALANCING before the first
# event lands — same race pattern as TC-9/10/12/13/14.
LG_STARTUP_DELAY=15

# Normal post-producer drain: gives dedup time to emit at least 2-3
# GAP_EMIT_INTERVAL_SEC=5 cycles before create runs.
TC_DRAIN_SECONDS=15

# create -> resend -> propagation wait. See tests/env/tc23-resend.sh.
POST_DRAIN_SCRIPT=tc23-resend.sh
TC23_BUNDLE_FILE=resend-23-all.json
TC23_PROPAGATION_WAIT=20
TC23_RESEND_EPS=50

# The generic sent/received/duplicate verdict is informational only here,
# not authoritative: input-filtered messages arrive at the sink with an
# empty VALUE, which breaks the sink's own regex-based counter extraction
# (see the caveat comment in downstream-lg-23-docker.properties). The
# real pass/fail is verify-tc23.sh, which checks dedup's own counters and
# directly scrapes the clean topic for leaked filtered content.
# EXPECTED_DUPLICATES requires an exact match (no range syntax, unlike
# EXPECTED_MISSING) — calibrated against an actual run below.

EXPECTED_DUPLICATES=0
EXPECTED_MISSING=0-100

VERIFY_SCRIPT=verify-tc23.sh
TC23_PARTITION_COUNT=15
