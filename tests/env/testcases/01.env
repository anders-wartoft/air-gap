# Testcase 1 — Resend with multiple time offsets
# Covers: REQ-2, REQ-3a, REQ-3c
# Source : traffic generated by LogGenerator against kafka-upstream.

TC_TITLE="Resend with multiple time offsets"
TC_COVERS="2, 3a, 3c"
TC_PROFILES=""

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-1.properties
# The bare-metal procedure replaces the air-gap downstream with
# LogGenerator-UDP. In the Docker env we keep the air-gap downstream running
# (it owns UDP:1234 inside the network) and point the LG sink at the
# downstream Kafka `transfer` topic instead (see downstream-lg-1-docker).
# A dedicated downstream config is needed because the generic
# downstream-docker.properties targets stdout and renames topics; the TC-1
# config writes decrypted/decoded events to kafka-downstream[transfer].
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-1.properties

# LogGenerator producer+sink so the runner auto-terminates when the producer
# has sent its `limit` events — otherwise TC-1 would hang the chain forever.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-1.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-1-docker.properties

# upstream-airgap-1.properties has two sendingThreads with different consumer
# groups, so every event is delivered twice through UDP → downstream →
# kafka-downstream[transfer]. The sink therefore sees 1000 unique and 1000
# duplicates; without this knob the default verdict (dupes must be 0) would
# always fail. See run-testcase.sh for how EXPECTED_DUPLICATES is honoured.
EXPECTED_DUPLICATES=1000

# Producer runs ~20s (eps=50, limit=1000); give the second sending thread
# time to catch up to the last message before we tear down.
TC_DRAIN_SECONDS=20

# Root cause of an intermittent single dropped delivery near the start of
# the run: upstream-a's Kafka consumer group and downstream's UDP listener
# socket are only "started" (per compose depends_on), not yet fully warmed
# up (group joined / socket bound) when lg-producer's first events would
# otherwise go out. A grace period — not a tolerance band — gives both
# sides time to settle before the first byte is sent. 15s matches the
# value already used by TC-9/10/12/13/14/17 for the same class of issue.
LG_STARTUP_DELAY=15
