# Testcase 3 — Plain-text traffic
# Covers: REQ-6

TC_TITLE="Plain-text traffic across the diode"
TC_COVERS="6"
TC_PROFILES=""

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-3.properties
# Docker-friendly downstream (writes to kafka-downstream[transfer] on all
# interfaces); the generic downstream-docker.properties targets stdout and
# wouldn't let the LG sink see anything.
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-3.properties

# LogGenerator producer+sink so the runner auto-exits on lg-producer.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-3.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-3-docker.properties

# Plain-text end-to-end: each event appears exactly once at the sink.
EXPECTED_DUPLICATES=0

# Producer runs ~20 s (eps=50, limit=1000); give the pipeline time to flush.
TC_DRAIN_SECONDS=15

# Root cause of an intermittent single dropped event near the start of the
# run (same class of issue found and fixed for TC-1/TC-2): upstream-a's
# Kafka consumer group and downstream's UDP listener socket are only
# "started" (per compose depends_on), not yet fully warmed up (group
# joined / socket bound) when lg-producer's first events would otherwise
# go out. A grace period — not a tolerance band — gives both sides time
# to settle before the first byte is sent.
LG_STARTUP_DELAY=15
