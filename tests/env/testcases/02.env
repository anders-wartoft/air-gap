# Testcase 2 — Upstream restart does not lose logs (at-least-once)
# Covers: REQ-5, REQ-9

TC_TITLE="Upstream restart does not lose logs"
TC_COVERS="5, 9"
TC_PROFILES=""

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-2.properties
# Docker-friendly downstream (writes to kafka-downstream[transfer] on all
# interfaces); the generic downstream-docker.properties targets stdout and
# wouldn't let the LG sink see anything.
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-2.properties

# LogGenerator producer+sink so the runner auto-exits on lg-producer.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-2.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-2-docker.properties

# TC-2 proves "upstream restart loses no logs". The LG producer runs at
# eps=50, limit=1000 (≈ 20 s). The runner force-recreates upstream-a at
# this many seconds into the run, which sends SIGTERM to the running
# process (graceful shutdown → Kafka offset commit) and starts a fresh
# container with the same groupID. Sarama resumes from the committed
# offset, so no events should be lost or duplicated.
UPSTREAM_A_RESTART_AT_SECONDS=10

# Generous drain so the restarted upstream has time to flush the second
# half of the producer window through UDP → downstream → kafka.
TC_DRAIN_SECONDS=25

# Root cause of an intermittent single dropped/duplicated delivery near the
# start of the run: upstream-a's Kafka consumer group and downstream's UDP
# listener socket are only "started" (per compose depends_on), not yet
# fully warmed up (group joined / socket bound) when lg-producer's first
# events would otherwise go out. A grace period — not a tolerance band —
# gives both sides time to settle before the first byte is sent. 15s
# matches the value already used by TC-9/10/12/13/14/17 for the same class
# of issue.
LG_STARTUP_DELAY=15

# A clean SIGTERM commits offsets, so a correct implementation produces
# exactly 0 duplicates on restart. If a future change starts producing a
# small handful (Sarama batching, late commits, etc.) convert this to the
# MAX_DUPLICATES knob instead.
EXPECTED_DUPLICATES=0
