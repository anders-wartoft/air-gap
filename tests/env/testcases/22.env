# Testcase 22 — TCP: downstream restart without loss
# Covers: REQ-37
#
# No Kafka, no LogGenerator anywhere in this testcase's data path:
# upstream generates its own synthetic "Random message N" counter
# (source=random) and downstream just prints what it receives (target=
# cmd). There's no natural auto-exit anchor (no `limit`, nothing finite),
# so tc22-settle-timer (docker-compose.yml) just bounds the total test
# duration while the real action — stopping and restarting the downstream
# container mid-run — is orchestrated from the host by run-testcase.sh's
# DOWNSTREAM_RESTART_AT_SECONDS/DOWNSTREAM_RESTART_DOWN_SECONDS watchdog.

TC_TITLE="TCP transport: downstream restart without loss"
TC_COVERS="37"
TC_PROFILES=""

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-tcp-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-tcp-docker.properties

AUTO_EXIT_PROFILE=tc22-settle-timer
AUTO_EXIT_SERVICE=tc22-settle-timer
# Total test duration: 10s baseline (downstream up, ~30 msgs at eps=3) +
# 8s downstream down (upstream retries/buffers) + ~12s running again
# after the restart, with a little slack.
TC22_SETTLE_SECONDS=30

# Stop downstream at T+10s (docker stop — graceful SIGTERM, same container
# so `docker logs downstream` stays one continuous, gap-checkable history
# across the restart), hold it down for 8s, then `docker start` it again.
DOWNSTREAM_RESTART_AT_SECONDS=10
DOWNSTREAM_RESTART_DOWN_SECONDS=8

# The real pass/fail: did downstream's sequence stay gapless/duplicate-
# free across the restart, and did upstream genuinely see (and recover
# from) the TCP outage?
VERIFY_SCRIPT=verify-tc22.sh
