# Testcase 11 — Redundancy (two upstreams against the same cluster, one dedup)
# Covers: REQ-24
#
# Two upstream air-gap processes (a and b) read the same topic from the
# same two-broker upstream Kafka cluster and send into the same downstream.
# Dedup collapses duplicates.
# Needs profiles: dual, dedup.

TC_TITLE="Redundancy: two upstreams, one downstream, one dedup"
TC_COVERS="24"
TC_PROFILES="dual dedup"

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-11a.properties
UPSTREAM_B_CONFIG=/airgap/config/testcases/upstream-airgap-11b.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-11a.properties
DEDUP_ENV_FILE=../../config/testcases/dedup-11a.env

# LogGenerator producer+sink (see testcases/09.env for how auto-exit works).
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-11.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-11.properties

# Dedup's Kafka Streams app needs time to finish REBALANCING/state
# restoration after startup before the first event flows through — same
# issue already fixed for every other dedup testcase (TC-9/10/12/13/14/17).
# TC-11 was apparently never retrofitted with this knob. A grace period —
# not a tolerance band — gives the dedup app time to settle before
# lg-producer's first events go out.
LG_STARTUP_DELAY=15
