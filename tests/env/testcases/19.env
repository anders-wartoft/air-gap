# Testcase 19 — Input filter (regex)
# Covers: REQ-33, REQ-34
#
# Needs the filter rule file: config/testcases/upstream-airgap-filter-19.txt
#
# Unlike the dedup-focused testcases, TC-19 is about WHICH LITERAL
# CONTENT gets through — not counters/gaps. LogGenerator has no "send
# this exact literal string" mode, so the real assertions run entirely
# inside POST_DRAIN_SCRIPT, which produces hand-crafted payloads
# directly via kafka-console-producer. LG_PRODUCER_CONFIG here is only
# a quick auto-exit ANCHOR (counter content that can never match any
# deny rule) so run-testcase.sh has something to wait on.

TC_TITLE="Regex input filter and filter counters"
TC_COVERS="33, 34"
TC_PROFILES=""

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-19-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-19-docker.properties

# Anchor burst — reused as-is from TC-17 (PLAINTEXT to kafka-upstream,
# TEST_N content, limit=100). No dedup, no gap concerns here.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-17.properties

TC_DRAIN_SECONDS=5

# The real test runs here — see tc19-inputfilter-test.sh.
POST_DRAIN_SCRIPT=tc19-inputfilter-test.sh
TC19_LG_ANCHOR_LIMIT=100
TC19_PROPAGATION_WAIT=8
