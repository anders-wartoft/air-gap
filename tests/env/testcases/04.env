# Testcase 4 — Encrypted traffic to and from Kafka
# Covers: REQ-7b, REQ-25, REQ-26, REQ-29

TC_TITLE="Kafka TLS to/from upstream and downstream"
TC_COVERS="7b, 25, 26, 29"
TC_PROFILES=""

# Docker variants of the TC-4 configs — they point caFile at
# certs/kafka/ssl/testenv-ca.crt (the CA that signed the broker SSL certs
# in the test env; the stock certs/tmp/kafka-ca.crt is a different, older
# CA that no longer matches what the Docker brokers advertise). The
# downstream variant also binds UDP to 0.0.0.0 so packets from upstream-a
# across the Docker bridge actually reach it.
UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-4-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-4-docker.properties

# IMPORTANT: docker-compose.yml defaults AIRGAP_*_BOOTSTRAP_SERVERS to the
# PLAINTEXT broker ports (9092/8092). TC-4 is a TLS test, so override both
# with the SSL ports (9094/8094) + the hostname the broker certs match
# (kafka-*.sitia.nu is listed in the SAN block).
UPSTREAM_A_BOOTSTRAP=kafka-upstream.sitia.nu:9094,kafka-upstream.sitia.nu:8094
DOWNSTREAM_BOOTSTRAP=kafka-downstream.sitia.nu:9094,kafka-downstream.sitia.nu:8094

# LogGenerator producer+sink so the runner auto-exits on lg-producer.
# LG itself stays on PLAINTEXT — the SSL hop under test is upstream↔Kafka
# and downstream↔Kafka, not LG↔Kafka.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-4.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-4-docker.properties

# Plain-text end-to-end from the sink's point of view: 1000 unique, 0 dupes.
EXPECTED_DUPLICATES=0

# Producer runs ~20 s (eps=50, limit=1000); extra slack for the TLS
# handshake and first metadata fetch on both ends.
TC_DRAIN_SECONDS=20

# Root cause of an intermittent single dropped event near the start of the
# run (same class of issue found and fixed for TC-1/TC-2): upstream-a's
# Kafka consumer group and downstream's UDP listener socket are only
# "started" (per compose depends_on), not yet fully warmed up (group
# joined / socket bound — here with the extra latency of the TLS
# handshake) when lg-producer's first events would otherwise go out. A
# grace period — not a tolerance band — gives both sides time to settle
# before the first byte is sent.
LG_STARTUP_DELAY=15
