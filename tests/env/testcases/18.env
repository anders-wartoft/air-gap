# Testcase 18 — Encrypted key files (passphrase-protected)
# Covers: REQ-32
#
# Verifies upstream, downstream, create AND resend can all load a
# passphrase-ENCRYPTED private key file to authenticate to Kafka over
# TLS, and that a MISSING/wrong password fails predictably (not
# silently, not by hanging).
#
# The main upstream/downstream pipeline proves the encrypted-key path
# for the air-gap binaries themselves (full delivery, 100/100, no
# filter — same pattern as TC-17). create/resend's positive AND
# negative cases run in POST_DRAIN_SCRIPT (tc18-mtls-test.sh), since
# they need FOUR separate one-shot invocations with different
# CONFIG/BOOTSTRAP overrides, which the normal CREATE_CONFIG/
# RESEND_CONFIG manifest vars can't express (only one value each).

TC_TITLE="Encrypted private-key files for Kafka TLS"
TC_COVERS="32"
TC_PROFILES=""

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-18-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-18-docker.properties

# Same asymmetric-CA + PLAINTEXT-default gotchas as TC-17: the
# upstream-a/downstream compose services always set
# AIRGAP_UPSTREAM_BOOTSTRAP_SERVERS / AIRGAP_DOWNSTREAM_BOOTSTRAP_SERVERS
# from these vars, overriding whatever's in the -docker.properties files.
UPSTREAM_A_BOOTSTRAP=kafka-upstream.sitia.nu:9094,kafka-upstream.sitia.nu:8094
DOWNSTREAM_BOOTSTRAP=kafka-downstream.sitia.nu:9094,kafka-downstream.sitia.nu:8094

# LogGenerator producer+sink — plain delivery check, no dedup.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-18-docker.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-18-docker.properties

# Grace period before LG starts producing. Unlike TC-17 (plain TLS),
# TC-18's upstream/downstream ALSO have to read+decrypt a passphrase-
# protected private key (PEM parse + legacy OpenSSL decrypt) before
# their Kafka consumer/producer can even begin the TLS handshake —
# extra startup latency on top of the handshake itself. Without this
# delay, LG can start producing before upstream's consumer has fully
# subscribed, losing the first event or two (observed: "missing-ids: 1"
# on the very first counter). Same root-cause pattern as TC-9/10's
# dedup REBALANCING race — a grace period, not a missing-count
# tolerance.
LG_STARTUP_DELAY=10

TC_DRAIN_SECONDS=10

EXPECTED_DUPLICATES=0
EXPECTED_MISSING=0

# Runs the create/resend positive+negative encrypted-key checks (see
# tc18-mtls-test.sh for what each of the 4 invocations asserts).
POST_DRAIN_SCRIPT=tc18-mtls-test.sh
