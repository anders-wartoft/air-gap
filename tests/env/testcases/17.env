# Testcase 17 — Dedup TLS/mTLS to Kafka
# Covers: REQ-31
#
# Verifies dedup connects to Kafka over TLS (server-auth only — the
# Docker brokers run KAFKA_SSL_CLIENT_AUTH=none, no mTLS). The chain
# also routes upstream/downstream through the SSL listener (9094/8094)
# so dedup is reading from a genuinely TLS-populated topic, not a
# PLAINTEXT one — mirrors the bare-metal procedure's full setup.
#
# No deliverFilter — TC-17 is a full-delivery test (100/100), unlike
# TC-13's deliberate gaps. The point here is TLS connectivity, not gap
# detection.

TC_TITLE="Dedup connects to Kafka with TLS + client cert"
TC_COVERS="31"
TC_PROFILES="dedup"

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-17-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-17-docker.properties
DEDUP_ENV_FILE=../../config/testcases/dedup-17-docker.env

# CRITICAL: the upstream-a/downstream compose services ALWAYS set
# AIRGAP_UPSTREAM_BOOTSTRAP_SERVERS / AIRGAP_DOWNSTREAM_BOOTSTRAP_SERVERS
# from these vars (defaulting to the PLAINTEXT ports), which overrides
# whatever bootstrapServers= is in the -docker.properties files. Without
# this, upstream/downstream silently try to speak TLS against the
# PLAINTEXT-only listener (9092/8092) — immediate EOF/connection-reset,
# not a clear TLS error. Same pattern as TC-6's manifest.
UPSTREAM_A_BOOTSTRAP=kafka-upstream.sitia.nu:9094,kafka-upstream.sitia.nu:8094
DOWNSTREAM_BOOTSTRAP=kafka-downstream.sitia.nu:9094,kafka-downstream.sitia.nu:8094

# CRITICAL: dedup's compose service sets BOOTSTRAP_SERVERS directly in
# `environment:`, which overrides dedup-17-docker.env's own
# BOOTSTRAP_SERVERS (same key, environment: wins over env_file). Without
# this override dedup silently connects PLAINTEXT on 9092/8092 instead
# of the SSL listener on 9094/8094, and the whole point of the test is
# lost without any visible error (the topics still exist on both
# listeners of the same broker).
DEDUP_BOOTSTRAP=kafka-downstream.sitia.nu:9094,kafka-downstream.sitia.nu:8094

# LogGenerator producer+sink. Both talk PLAINTEXT to Kafka directly
# (LogGenerator itself isn't part of what TC-17 is testing), reused
# as-is from the bare-metal procedure.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-17.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-17.properties

# Dedup Kafka Streams needs 10-15s to finish REBALANCING before the
# first event lands — same race pattern as TC-9/10/12/13/14. TLS
# handshake adds a little more startup latency on top of that.
LG_STARTUP_DELAY=15

# Full delivery expected — no gaps, no duplicates.
EXPECTED_DUPLICATES=0
EXPECTED_MISSING=0

# Prove dedup ACTUALLY used TLS (not that the test happened to pass
# while silently falling back to PLAINTEXT). verify-tc17.sh checks
# dedup's own startup log for the SSL bootstrap servers and the
# injected KAFKA_SECURITY_PROTOCOL=SSL property, plus absence of any
# SSL handshake/authentication errors.
VERIFY_SCRIPT=verify-tc17.sh
