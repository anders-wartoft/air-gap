# Testcase 8 — logrotate / SIGHUP
# Covers: REQ-18, REQ-23

TC_TITLE="SIGHUP reopens the configured log file"
TC_COVERS="18, 23"
TC_PROFILES=""

# Docker variants write their log to /tmp/<name>.log (writable in any
# container) instead of the ./tmp/<name>.log the bare-metal file uses —
# the latter would fatal inside the airgap container because the
# WORKDIR has no ./tmp/.
UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-8-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-8-docker.properties

# Chain orchestration:
#   1. compose brings up upstream-a, downstream, and a one-shot
#      tc8-settle-timer container (6 s sleep, then emits LG-compatible
#      summary lines + exits).
#   2. The runner's auto-exit detector fires on tc8-settle-timer exit.
#   3. VERIFY_SCRIPT=verify-tc8.sh runs on the host, performing the
#      actual SIGHUP test via `docker exec mv`, `docker kill --signal=HUP`,
#      and `docker exec grep` for the "Logrotate completed" / "SIGHUP
#      received" markers on both upstream-a and downstream.
AUTO_EXIT_PROFILE=tc8-settle-timer
AUTO_EXIT_SERVICE=tc8-settle-timer
TC8_SETTLE_SECONDS=6
VERIFY_SCRIPT=verify-tc8.sh

# The verdict parser sees sent=2 / received=2 from the settle-timer's
# summary lines (two SIGHUP rotations are planned). verify-tc8.sh is
# what actually turns that nominal PASS into a real one — if either
# rotation fails, the runner downgrades the chain verdict to FAIL.
EXPECTED_DUPLICATES=0
TC_DRAIN_SECONDS=2
