# Testcase 6 — Encryption over the diode
# Covers: REQ-7a

TC_TITLE="Encrypted upstream->downstream over the diode"
TC_COVERS="7a"
TC_PROFILES=""

# Docker variants: TLS to Kafka + UDP payload encryption. The upstream
# publicKeyFile=certs/server2.pem is matched by downstream
# privateKeyFiles=certs/private*.pem (both ship with the repo).
UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-6-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-6-docker.properties

# Both clusters use SSL in TC-6 — override the PLAINTEXT compose defaults.
# (The two clusters are signed by different CAs; see the headers of the
# -docker.properties files for the asymmetry.)
UPSTREAM_A_BOOTSTRAP=kafka-upstream.sitia.nu:9094,kafka-upstream.sitia.nu:8094
DOWNSTREAM_BOOTSTRAP=kafka-downstream.sitia.nu:9094,kafka-downstream.sitia.nu:8094

# LogGenerator producer+sink so the runner auto-exits on lg-producer.
# LG itself stays on PLAINTEXT; the hops under test are upstream↔Kafka
# (TLS), downstream↔Kafka (TLS) and upstream↔downstream UDP (encrypted).
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-6.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-6-docker.properties

EXPECTED_DUPLICATES=0

# Encryption adds a key-exchange handshake at startup + rotates every
# generateNewSymmetricKeyEvery=50 s. Keep the drain generous so the final
# events after the producer finishes have time to flow through.
TC_DRAIN_SECONDS=20

# Root cause of an intermittent single dropped event near the start of the
# run (same class of issue found and fixed for TC-1/TC-2): upstream-a's
# Kafka consumer group and downstream's UDP listener socket are only
# "started" (per compose depends_on), not yet fully warmed up (group
# joined / socket bound — here with the extra latency of the symmetric-key
# exchange handshake) when lg-producer's first events would otherwise go
# out. A grace period — not a tolerance band — gives both sides time to
# settle before the first byte is sent.
LG_STARTUP_DELAY=15
