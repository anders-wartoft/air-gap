# Testcase 13 — Dedup monitoring (counters + MISSING-REPORT)
# Covers: REQ-27, REQ-28
#
# TC-13 is about dedup's periodic monitoring output. The LG producer
# writes 100 events to kafka-upstream[transfer]; upstream carries
# deliverFilter=2,4,6 which forwards only even Kafka offsets (half the
# stream, 50 events). Dedup consumes transfer, emits unique events to
# `dedup`, and prints a [MISSING-REPORT] JSON line per partition every
# GAP_EMIT_INTERVAL_SEC seconds showing received/emitted/missing
# counters (both totals and deltas).
#
# The LG sink then sees 50 unique + 50 missing — the 50 missing is
# INTENTIONAL (REQ-28 "missing-entry logging" wouldn't be observable
# otherwise), so the manifest sets EXPECTED_MISSING=50 to allow it.
# The verify-tc13.sh script then proves the MISSING-REPORT lines
# actually appeared with the required counter fields.

TC_TITLE="Dedup logs received/sent counters and missing-report"
TC_COVERS="27, 28"
TC_PROFILES="dedup"

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-13-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-13-docker.properties
DEDUP_ENV_FILE=../../config/testcases/dedup-13-docker.env

# LogGenerator producer+sink.
LG_PRODUCER_CONFIG=/airgap/config/testcases/upstream-lg-13-docker.properties
LG_SINK_CONFIG=/airgap/config/testcases/downstream-lg-13.properties

# Dedup Kafka Streams needs 10–15 s to finish REBALANCING before the
# first event lands — same race pattern as TC-9/10/12.
LG_STARTUP_DELAY=15

# TC-13 drops ~half the stream on purpose (deliverFilter=2,4,6) so
# that dedup's MISSING-REPORT counters observe something to count.
# Kafka's sticky partitioner doesn't distribute the 100 events evenly
# across the 5 upstream partitions, so the per-chain missing count
# lands anywhere in a narrow window around 50 (observed: 49, 50, 51).
# The range syntax `LO-HI` lets the runner tolerate that without
# masking a real chain failure.
EXPECTED_MISSING=40-60
EXPECTED_DUPLICATES=0

# Extra drain time so the final [MISSING-REPORT] cycle (every 5 s per
# dedup-13-docker.env's GAP_EMIT_INTERVAL_SEC) has a chance to be
# emitted before teardown.
TC_DRAIN_SECONDS=20

# Prove dedup actually emitted periodic reports with the right fields.
# verify-tc13.sh greps `docker logs airgap-testenv-dedup-1` for
# [MISSING-REPORT] JSON lines and asserts:
#   * at least TC13_MIN_REPORTS lines appeared
#   * each contains the REQ-27/28 counter fields (total_received,
#     delta_received, total_emitted, delta_emitted, total_missing,
#     delta_missing)
#   * the last-cycle sums show received/emitted/missing > 0
#   * the interval the app logged at startup matches
#     TC13_EXPECTED_INTERVAL (= dedup-13-docker.env GAP_EMIT_INTERVAL_SEC)
VERIFY_SCRIPT=verify-tc13.sh
TC13_EXPECTED_INTERVAL=5
TC13_MIN_REPORTS=2
