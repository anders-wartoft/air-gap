# Testcase 25 — SO_RXQ_OVFL kernel drop counter
# Covers: REQ-49
#
# "Linux only" per the manual procedure (SO_RXQ_OVFL is a Linux socket
# flag) — but every container in this Docker rig IS Linux regardless of
# host OS, so this is fully chain-automatable despite the platform note.
#
# No Kafka, no LogGenerator in this testcase's data path (source=random
# upstream, target=cmd downstream, same shape as TC-22/24) —
# tc25-settle-timer just bounds the negative-control settle window; ALL
# the real testing (negative control, positive control, bonus blast)
# happens in POST_DRAIN_SCRIPT=tc25-rxqovfl-test.sh.

TC_TITLE="SO_RXQ_OVFL kernel drop counter in statistics"
TC_COVERS="49"
TC_PROFILES=""

UPSTREAM_A_CONFIG=/airgap/config/testcases/upstream-airgap-25-docker.properties
DOWNSTREAM_CONFIG=/airgap/config/testcases/downstream-airgap-25-docker.properties

AUTO_EXIT_PROFILE=tc25-settle-timer
AUTO_EXIT_SERVICE=tc25-settle-timer
TC25_SETTLE_SECONDS=12

# All real testing happens here — see tc25-rxqovfl-test.sh. report_check
# lines ARE the pass/fail for this testcase; the generic sent/received/
# duplicate verdict is a trivial marker-line pass (no Kafka/LG in this
# test's data path, same as TC-22/24), not authoritative.
POST_DRAIN_SCRIPT=tc25-rxqovfl-test.sh

EXPECTED_DUPLICATES=0
EXPECTED_MISSING=0
